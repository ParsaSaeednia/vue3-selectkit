{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.vue",
    "docs/**/*.ts",
    "docs/**/*.vue",
    "tests/types/**/*.vue"
  ],
  "exclude": ["docs/.vitepress/cache", "docs/.vitepress/dist"]
}
